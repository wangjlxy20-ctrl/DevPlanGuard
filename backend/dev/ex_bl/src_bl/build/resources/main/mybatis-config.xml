<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-config.dtd">

<!-- Reference:http://www.mybatis.org/mybatis-3/ja/configuration.html -->
<configuration>
	<environments default="document_builder">

		<!-- Access control master -->
		<environment id="access_control">
			<transactionManager type="JDBC"/>
			<dataSource type="POOLED">
				<!-- Framework default -->
				<property name="driver" value="biz.grandsight.ex.ui.jdbc.sqlite.JDBC"/>
				<property name="url" value="mst/access_control.db3"/>

				<!-- Example of connecting to SQLite with any file path -->
				<!-- 	url: prefix with "jdbc: sqlite:" and continue with the file path. -->
				<!--
				<property name="driver" value="org.sqlite.JDBC"/>
				<property name="url" value="jdbc:sqlite:C:/EX/UI/wildfly-10.1.0.Final/standalone/deployments/UI.war/mst/access_control.db3"/>
				-->

				<!-- Example of JDBC connection to another DB -->
				<!--   The following example is for MySQL -->
				<!--
				<property name="driver" value="com.mysql.jdbc.Driver"/>
				<property name="url" value="jdbc:mysql://localhost:3306/access_control"/>
				<property name="username" value="xxxxx"/>
				<property name="password" value="xxxxxxxxxx"/>
				-->
			</dataSource>

			<!-- Example of connection with data source -->
			<!--
			<dataSource type="JNDI">
				<property name="data_source" value="java:jboss/datasources/ExampleDS"/>
			</dataSource>
			-->
		</environment>

		<!-- File upload access control master -->
		<environment id="file_upload">
			<transactionManager type="JDBC"/>
			<dataSource type="POOLED">
				<!-- Framework default -->
				<property name="driver" value="biz.grandsight.ex.ui.jdbc.sqlite.JDBC"/>
				<property name="url" value="mst/file_upload.db3"/>
			</dataSource>
		</environment>

		<!-- Screen builder master -->
		<environment id="document_builder">
			<transactionManager type="JDBC"/>
			<dataSource type="POOLED">
				<property name="driver" value="biz.grandsight.ex.ui.jdbc.sqlite.JDBC"/>
				<property name="url" value="mst/fw_mst.db3"/>
			</dataSource>
		</environment>

	    <environment id="globalization">
			<transactionManager type="JDBC"/>
			<dataSource type="POOLED">
				<!-- Framework default -->
				<property name="driver" value="biz.grandsight.ex.ui.jdbc.sqlite.JDBC"/>
				<property name="url" value="mst/access_control.db3"/>
			</dataSource>

		</environment>
	</environments>

	<!-- Location of mapping XML -->
	<mappers>
		<package name="biz.grandsight.ex.ui.ac.io.mybatis"/>
		<package name="biz.grandsight.ex.ui.bl.io.mybatis"/>
		<package name="biz.grandsight.ex.ui.fileupload.io.mybatis"/>
		<package name="biz.grandsight.ex.globalization.io.mybatis"/>
	</mappers>
</configuration>
