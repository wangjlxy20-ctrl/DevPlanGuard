  <datasource 
    type="CUSTOM" 
    class="com.yse.gb.datacol.CustomCollection"
    description="Customized data source" >

      <param
        name="CLASS_NAME"
        disp="name of the class"
        description="Specify the data source class name."/>

      <input_param 
        name="param1"
        disp="Parameter 1" 
        description="Parameter 1"/>
      <input_param 
        name="param2"
        disp="Parameter 2" 
        description="Parameter 2"/>
