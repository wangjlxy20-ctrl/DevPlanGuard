<?xml version="1.0" encoding="UTF-8"?>

<datasource_mst>

　<datasource_disp type="Data source type" class="name of the class" description="description"/>

  <datasource 
    type="OPC"
    class="com.yse.gb.datacol.OPCDACollection" 
    description="Standard OPC data source: Can get the value in [tag name.item name] format." >

      <param
        name="DA_PROG_ID"
        disp="DA server program ID"
        description="Specify the program ID of the DA server." />

      <param 
        name="SERVER_NAME1" 
        disp="OPC server"
        description="Specify the OPC server name."/>
<!--
      <param 
        name="SERVER_NAME2" 
        disp="OPC server 2"
        description="Specify the OPC server name. (OPC server 2 is used when the OPC server is abnormal)"/>
-->
      <param 
        name="SEPARATOR" 
        disp="Delimiter"
        description="Specify the delimiter between the tag name and the item name."/>

      <input_param 
        name="param1"
        disp="Tag name" 
        description="Specify the tag name."/>
      <input_param 
        name="param2"
        disp="Item name" 
        description="Specify the item name."/>

  </datasource>
  <datasource 
    type="DB"
    class="com.yse.gb.datacol.DBCollection" 
    description="Standard DB data source: Can get the value using SQL statement." >

      <param 
        name="DRIVER" 
        disp="JDBC driver"
        description="Specify the JDBC driver name. (Example) oracle.jdbc.driver.OracleDriver"/>
      <param 
        name="URL" 
        disp="JDBC URL"
        description="Specify the JDBC URL. (Example) jdbc: oracle: thin: @ yse-56: 1521: ORCL"/>
      <param 
        name="USER" 
        disp="User name"
        description="Specify the user name to connect to the DB."/>
      <param 
        name="PASSWORD" 
        disp="password"
        description="Specify the password to connect to the DB."/>
      <param 
        name="PARAM" 
        disp="Parameters"
        description="It is used when specifying parameters other than the above."/>

      <input_param 
        name="param1"
        disp="SQL statement" 
        description="Descript the SQL statement."/>

  </datasource>
