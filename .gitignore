# 1. 常规忽略（不管哪个端都要忽略的杂物）
*.class
*.jar
*.png
*.log
.env
*.db
*.sqlite
node_modules/
.idea/
.gradle/
.DS_Store
Thumbs.db

# 2. 忽略整个 backend 目录
/backend/*

# 3. 逐层放行 job 目录（注意路径拼写）
!/backend/dev/
/backend/dev/*
!/backend/dev/ex_bl/
/backend/dev/ex_bl/*
!/backend/dev/ex_bl/src_bl/
/backend/dev/ex_bl/src_bl/*
!/backend/dev/ex_bl/src_bl/WEB-INF/
/backend/dev/ex_bl/src_bl/WEB-INF/*
!/backend/dev/ex_bl/src_bl/WEB-INF/src/
/backend/dev/ex_bl/src_bl/WEB-INF/src/*
!/backend/dev/ex_bl/src_bl/WEB-INF/src/job/