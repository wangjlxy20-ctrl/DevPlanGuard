# 1. 常规忽略（不管 front 还是 backen 都不提交的）
*.class
*.jar
*.png
*.log
.env
*.db
*.sqlite
node_modules/
.DS_Store
Thumbs.db

# 2. 忽略整个 backen 目录
/backen/*

# 3. 逐层放行 job 目录（Git 要求父目录也必须被放行才能进入）
!/backen/dev/
/backen/dev/*
!/backen/dev/ex_bl/
/backen/dev/ex_bl/*
!/backen/dev/ex_bl/src_bl/
/backen/dev/ex_bl/src_bl/*
!/backen/dev/ex_bl/src_bl/WEB-INF/
/backen/dev/ex_bl/src_bl/WEB-INF/*
!/backen/dev/ex_bl/src_bl/WEB-INF/src/
/backen/dev/ex_bl/src_bl/WEB-INF/src/*
!/backen/dev/ex_bl/src_bl/WEB-INF/src/job/