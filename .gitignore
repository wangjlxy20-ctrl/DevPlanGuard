
# 忽略文档文件
*.xlsx
*.docx

# 1. 常规忽略
*.class
*.jar
*.log
.env
*.db
*.sqlite
.idea/
.gradle/
.DS_Store
Thumbs.db

# 2. 忽略整个 front 目录
/front/*

# 3. 逐层放行 front 目录结构
!/front/
!/front/**/*.html
!/front/**/*.jsp

# 4. 忽略整个 backend 目录
/backend/*

# 5. 逐层放行 job 目录
!/backend/dev/
/backend/dev/*
!/backend/dev/ex_bl/
/backend/dev/ex_bl/*
!/backend/dev/ex_bl/src_bl/
/backend/dev/ex_bl/src_bl/*
!/backend/dev/ex_bl/src_bl/WEB-INF/
/backend/dev/ex_bl/src_bl/WEB-INF/*
!/backend/dev/ex_bl/src_bl/WEB-INF/src/
/backend/dev/ex_bl/src_bl/WEB-INF/src/*
!/backend/dev/ex_bl/src_bl/WEB-INF/src/job/